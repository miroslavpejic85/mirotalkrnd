# App
APP_OFFLINE=false
APP_NAME="Random Talk"
REPORT_EMAIL_LINK="mailto:support@example.com"
REPORT_EMAIL_TEXT="support@example.com"
OFFLINE_MESSAGE="We are currently offline for maintenance. Please check back soon."

# Social
OG_TITLE="Random Talk"
OG_DESCRIPTION="Meet someone random. Talk instantly."
OG_IMAGE="http://localhost:4010/images/social/og-image.png"
OG_URL="http://localhost:4010"
TWITTER_CARD="summary_large_image"

# Server
NODE_ENV=development # or production
PORT=4010
USE_HTTPS=false
TRUST_PROXY=false # Set to true or 1 when running behind a reverse proxy (e.g. Nginx)
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# Real-time capacity limits
MAX_ACTIVE_USERS=200
MAX_QUEUE_USERS=200
MAX_CONNECTIONS_PER_IP=5

# Abuse/rate limits
SKIP_RATE_LIMIT_PER_10S=8
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# STUN servers (comma-separated)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN fallback (comma-separated), for users behind strict NAT/firewalls
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
